PORT=5000
MONGO_DB_URI=your_mongodb_connection_string
CLIENT_URL=http://localhost:3000
STRIPE_SECRET_KEY=your_stripe_secret_key
JWT_SECRET=your_jwt_secret
ADMIN_EMAIL=admin@recipehub.com

# Real-World SMTP Email Service Configuration
# For Gmail: Use your Gmail address and 16-character Google App Password (not your personal account password)
# How to get Google App Password: 
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app named "RecipeHub" and copy the 16-character code
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="RecipeHub" <your_email@gmail.com>
